  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "用于明确的主要任务。",
      "html": "<button class=\"ds-button ds-primary\">加入计划</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:11px 18px;border:1px solid transparent;border-radius:var(--control-radius,10px);font:600 14px/1.4 sans-serif;cursor:pointer;transition:background-color .18s,transform .18s}.ds-button:focus-visible{outline:3px solid var(--focus,#b74428);outline-offset:4px}.ds-button:active{transform:scale(.98)}.ds-primary{background:var(--accent,#b74428);color:var(--on-accent,#fff)}.ds-primary:hover{background:var(--accent-hover,#97361e)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "与主动作相邻的次要选择。",
      "html": "<button class=\"ds-button ds-secondary\">换一道</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:11px 18px;border:1px solid transparent;border-radius:var(--control-radius,10px);font:600 14px/1.4 sans-serif;cursor:pointer;transition:background-color .18s,transform .18s}.ds-button:focus-visible{outline:3px solid var(--focus,#b74428);outline-offset:4px}.ds-button:active{transform:scale(.98)}.ds-secondary{background:var(--surface,#fff);color:var(--text,#27352c);border-color:var(--line,#dde4d9)}.ds-secondary:hover{background:var(--subtle,#edf1e8)}"
    },
    {
      "name": "Direct meal choice",
      "kind": "button",
      "refersTo": "button-choice",
      "description": "推荐照片下的直接选择。",
      "html": "<button class=\"ds-button ds-choice\">就选这道</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:11px 18px;border:1px solid transparent;border-radius:var(--control-radius,10px);font:600 14px/1.4 sans-serif;cursor:pointer;transition:background-color .18s,transform .18s}.ds-button:focus-visible{outline:3px solid var(--focus,#b74428);outline-offset:4px}.ds-button:active{transform:scale(.98)}.ds-choice{min-height:48px;background:var(--text,#27352c);color:var(--surface,#fff)}.ds-choice:hover{background:var(--accent,#b74428);color:var(--on-accent,#fff)}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "搜索完整菜品集合。",
      "html": "<label class=\"ds-search\"><span>搜索</span><input type=\"search\" aria-label=\"搜索美食\" placeholder=\"菜名、分类或描述\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:12px;min-height:48px;padding:0 16px;border:1px solid var(--line,#dde4d9);border-radius:12px;background:var(--surface,#fff);color:var(--muted,#626e65);font:14px sans-serif}.ds-search input{min-width:0;flex:1;border:0;background:none;color:var(--text,#27352c);font:inherit;padding:10px 0;outline:none}.ds-search:focus-within{outline:2px solid var(--focus,#b74428);outline-offset:2px}.ds-search:hover{border-color:var(--muted,#626e65)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "真实链接，选中项使用强调背景。",
      "html": "<nav class=\"ds-nav\" aria-label=\"导航预览\"><a href=\"#wheel\" aria-current=\"page\">今天吃什么</a><a href=\"#list\">美食菜单</a><a href=\"#plan\">一周计划</a></nav>",
      "css": ".ds-nav{display:grid;gap:8px;max-width:190px;font:14px sans-serif}.ds-nav a{padding:12px 15px;border-radius:10px;text-decoration:none;color:var(--muted,#626e65)}.ds-nav [aria-current]{background:var(--accent-soft,#f8e9e2);color:var(--accent,#b74428);font-weight:650}.ds-nav a:hover{background:var(--subtle,#edf1e8)}.ds-nav a:focus-visible{outline:3px solid var(--focus,#b74428);outline-offset:3px}"
    },
    {
      "name": "Category chip",
      "kind": "chip",
      "refersTo": "navigation-active",
      "description": "分类筛选保留按钮语义。",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">米粉面馆</button>",
      "css": ".ds-chip{min-height:38px;padding:7px 14px;border:1px solid var(--accent,#b74428);border-radius:9px;background:var(--accent-soft,#f8e9e2);color:var(--accent,#b74428);font:13px sans-serif;cursor:pointer}.ds-chip:hover{background:var(--subtle,#edf1e8)}.ds-chip:focus-visible{outline:3px solid var(--focus,#b74428);outline-offset:3px}.ds-chip:active{transform:scale(.98)}"
    },
    {
      "name": "Food card",
      "kind": "card",
      "refersTo": "feature-surface",
      "description": "图片、菜名与描述直接组成菜单。",
      "html": "<article class=\"ds-card\"><button aria-label=\"查看黄焖鸡米饭\"><img src=\"data:image/webp;base64,\" alt=\"黄焖鸡米饭\"><small>快餐便当</small><strong>黄焖鸡米饭</strong><p>鸡肉软烂，汤汁浓郁</p></button></article>",
      "css": ".ds-card{max-width:270px}.ds-card button{display:block;border:0;padding:0;background:none;color:var(--text,#27352c);text-align:left;cursor:pointer;font:13px/1.65 sans-serif}.ds-card img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px}.ds-card small{display:block;margin-top:13px;color:var(--muted,#626e65);font-size:11px}.ds-card strong{display:block;font-size:17px;margin:4px 0 5px}.ds-card p{margin:0;color:var(--muted,#626e65)}.ds-card button:focus-visible{outline:3px solid var(--focus,#b74428);outline-offset:4px}.ds-card button:hover strong{color:var(--accent,#b74428)}"
    }
  ],
  "narrative": {
    "northStar": "鲜食菜单",
    "overview": "v3.2.0 的视觉系统围绕真实食物和明确选择建立。白色内容区、植物色中性背景与珊瑚色交互强调形成层次，照片承担主要视觉内容。中文任务界面使用本机字体，保持快速加载与可读性。",
    "keyCharacteristics": [
      "菜品照片与直接选择动作相邻。",
      "页面依靠留白、背景和少量分隔线组织内容。",
      "主次操作、选中与等待状态可辨认。",
      "桌面、手机及深色模式保持同一套组件语言。"
    ],
    "rules": [
      {
        "name": "Semantic State",
        "body": "强调、成功和错误分别使用对应语义 token，不能只靠颜色表达状态。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 让照片、菜名和选择动作保持直接的阅读顺序。",
      "Do 以共享语义 token 维护明暗与六色主题。",
      "Do 同时保留键盘、减少动态效果、长名称和图片失败状态。",
      "Do 把派生图片与原图一起发布，并检查缩略图大小预算。"
    ],
    "donts": [
      "Don't 将店铺参考图表达成本店实拍，或把口味标签当作食材保证。",
      "Don't 在动画每一帧重建图片、重绘盘面或更新整页。",
      "Don't 为背景装饰引入持续动画和额外网络依赖。"
    ]
  }
}
