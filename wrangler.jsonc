{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "chishenme-api",
  "main": "server/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "region": "aws:ap-east-1" },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/runtime-config.json"]
  },
  "routes": [
    { "pattern": "eat.zhouquanji.eu.cc", "custom_domain": true, "zone_id": "dcf0e77ae3f25e3899e1c79a1e7288eb" }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://gwshhh.github.io"
  },
  "ratelimits": [
    {
      "name": "NEARBY_LIMITER",
      "namespace_id": "1072801",
      "simple": { "limit": 40, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
